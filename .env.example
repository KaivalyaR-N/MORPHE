# MORPHE Environment Configuration

# Database Configuration (SQLite async by default for quick dev, PostgreSQL async for production)
DATABASE_URL=sqlite+aiosqlite:///./morphe.db
# DATABASE_URL=postgresql+asyncpg://morphe_user:morphe_password@localhost:5432/morphe_db

# Redis Task Queue / Cache
REDIS_URL=redis://localhost:6379/0

# Security / Authentication
JWT_SECRET=morphe-super-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# File Storage Paths
STORAGE_DIR=./storage
EXPORTS_DIR=./storage/exports

# AI / LLM Configuration (Gemini API / Heuristic fallback)
AI_PROVIDER=auto
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Optional Grobid Service Integration
GROBID_URL=http://localhost:8070

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
